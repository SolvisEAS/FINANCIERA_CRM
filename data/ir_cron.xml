<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_control_tareas" model="ir.cron">
        <field name="name">Financiera: control de tareas (sin seguimiento)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._fin_cron_sin_seguimiento()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_recordatorios" model="ir.cron">
        <field name="name">Financiera: recordatorios de tareas</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">model._fin_cron_recordatorios()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
    <record id="cron_meta_reintentar" model="ir.cron">
        <field name="name">Financiera: reintentar leads de Meta</field>
        <field name="model_id" ref="model_financiera_meta_lead"/>
        <field name="state">code</field>
        <field name="code">model._cron_reintentar()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
