<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendedoras_list" model="ir.ui.view">
        <field name="name">financiera.vendedoras.list</field>
        <field name="model">res.users</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Vendedoras" editable="bottom" create="0" delete="0">
                <field name="fin_orden" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="login" readonly="1" string="Usuario"/>
                <field name="fin_disponible" widget="boolean_toggle"/>
                <field name="fin_tope_abiertas"/>
                <field name="fin_abiertas_count"/>
            </list>
        </field>
    </record>

    <record id="action_vendedoras" model="ir.actions.act_window">
        <field name="name">Vendedoras y disponibilidad</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="domain">[('fin_es_vendedora', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_vendedoras_list')})]"/>
    </record>

    <record id="view_whatsapp_estado_list" model="ir.ui.view">
        <field name="name">financiera.whatsapp.estado.list</field>
        <field name="model">res.users</field>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <list string="WhatsApp por vendedora" editable="bottom" create="0" delete="0"
                  decoration-danger="fin_wa_estado == 'desconectado'">
                <field name="name" readonly="1"/>
                <field name="fin_wa_numero"/>
                <field name="fin_wa_estado" widget="badge" decoration-success="fin_wa_estado == 'conectado'"
                       decoration-danger="fin_wa_estado == 'desconectado'" readonly="1"/>
                <field name="fin_wa_ultimo" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_whatsapp_estado" model="ir.actions.act_window">
        <field name="name">WhatsApp por vendedora</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="domain">[('fin_es_vendedora', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_whatsapp_estado_list')})]"/>
    </record>
</odoo>
