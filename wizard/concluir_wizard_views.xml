<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_concluir_wizard_form" model="ir.ui.view">
        <field name="name">financiera.concluir.wizard.form</field>
        <field name="model">financiera.concluir.wizard</field>
        <field name="arch" type="xml">
            <form string="Concluir tarea" class="o_fin_form o_fin_concluir">
                <field name="activity_id" invisible="1"/>
                <field name="requiere_proxima" invisible="1"/>
                <field name="es_primer_contacto" invisible="1"/>
                <field name="nueva_etapa_codigo" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="mb-2">
                    <div class="text-muted small">Tarea</div>
                    <div class="fw-bold"><field name="tarea_asunto" readonly="1"/></div>
                    <div invisible="not es_primer_contacto" class="small text-primary">
                        Al concluir el primer contacto la oportunidad pasa sola a "10 · Contactado".
                    </div>
                </div>
                <field name="conclusion" widget="radio" options="{'horizontal': true}" class="o_fin_conclusion"/>
                <div class="alert alert-warning mt-2 mb-0" role="alert" invisible="not aviso">
                    <field name="aviso" readonly="1"/>
                </div>
                <group invisible="not conclusion">
                    <field name="nota" placeholder="¿Qué se habló?" required="conclusion == 'respondio'"/>
                    <field name="producto" string="Producto"
                           invisible="producto not in (False, 'sin_definir')"/>
                    <field name="nueva_etapa_id" options="{'no_create': True, 'no_open': True}"
                           invisible="conclusion == 'reprogramar'"/>
                    <field name="importe_final" invisible="nueva_etapa_codigo != '40'" required="nueva_etapa_codigo == '40'"/>
                    <field name="lost_reason_id" invisible="nueva_etapa_codigo != '50'" required="nueva_etapa_codigo == '50'"
                           options="{'no_create': True}"/>
                </group>
                <div invisible="not conclusion or not requiere_proxima" class="o_fin_proxima">
                    <h5 class="mt-2">Próxima tarea</h5>
                    <group>
                        <group>
                            <field name="proxima_asunto" required="requiere_proxima and conclusion"/>
                            <field name="proxima_fecha" required="requiere_proxima and conclusion"
                                   options="{'show_seconds': false}"/>
                        </group>
                        <group>
                            <field name="proxima_modalidad"/>
                            <field name="proxima_tipo"/>
                            <field name="proxima_recordatorio"/>
                        </group>
                    </group>
                </div>
                <footer>
                    <button name="action_confirmar" type="object" string="Concluir" class="btn-primary" data-hotkey="q"
                            invisible="not conclusion"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
